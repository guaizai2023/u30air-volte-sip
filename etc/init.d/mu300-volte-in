#!/bin/sh /etc/rc.common
# mu300-volte-in -- 监听 VoLTE 来电并呼叫 SIP 分机
START=96
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/python3 /usr/bin/mu300-volte-in.py
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
