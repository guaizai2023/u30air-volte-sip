#!/bin/sh /etc/rc.common

# mu300-bridge —— SIP <-> VoLTE 音频桥
# 用法：/etc/init.d/mu300-bridge {start|stop|restart|enable|disable}
# 日志：/tmp/bridge.log

START=98
STOP=10
USE_PROCD=1

PROG=/usr/bin/mu300-bridge.py
RUN_LOG=/tmp/bridge.log

start_service() {
	# 记录一次启动分隔，便于排查
	echo "----- $(date '+%F %T') service start -----" >> "$RUN_LOG"

	procd_open_instance
	procd_set_param command /usr/bin/python3 "$PROG"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	echo "----- $(date '+%F %T') service stop -----" >> "$RUN_LOG"
}
