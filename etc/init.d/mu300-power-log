#!/bin/sh /etc/rc.common
# mu300-power-log -- 记录电池充放电与低电量告警
START=97
STOP=05
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/python3 /usr/bin/mu300-power-log.py
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
